# ═══════════════════════════════════════════════════════════════════════════════
# PKLinks Backend — .gitignore
# Applies to the backend/ directory and all microservices inside it
# ═══════════════════════════════════════════════════════════════════════════════


# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js


# ── Environment & Secrets ──────────────────────────────────────────────────────
# Root backend env
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# All service-level .env files (e.g. auth-service/.env)
*/.env
*/.env.local
*/.env.development
*/.env.development.local
*/.env.test
*/.env.test.local
*/.env.production
*/.env.production.local


# ── Build Outputs ──────────────────────────────────────────────────────────────
dist/
*/dist/
build/
*/build/
*.tsbuildinfo


# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# ── Runtime ───────────────────────────────────────────────────────────────────
*.pid
*.pid.lock


# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
*/coverage/
*.lcov
.nyc_output/


# ── Dev Artifacts ─────────────────────────────────────────────────────────────
scratch/
*/scratch/
tmp/
temp/


# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
